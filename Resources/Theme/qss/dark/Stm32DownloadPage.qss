QScrollArea#Stm32DownloadPage,
QWidget#stm32ScrollWidget {
    background-color: transparent;
    border: none;
}

QScrollArea#Stm32DownloadPage QTextEdit,
QScrollArea#Stm32DownloadPage QLineEdit,
QScrollArea#Stm32DownloadPage LineEdit {
    color: #ffffff;
}

QScrollArea#Stm32DownloadPage QTextEdit {
    background: rgba(255, 255, 255, 0.04);
}

QScrollArea#Stm32DownloadPage QTextEdit::selection {
    background: #3d6fb3;
    color: #ffffff;
}

