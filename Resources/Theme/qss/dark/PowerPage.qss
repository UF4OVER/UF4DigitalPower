QScrollArea#PowerPage {
    background: transparent;
    border: none;
}

QWidget#powerScrollWidget {
    background: transparent;
    border: none;
    border-radius: 0;
}

QWidget#powerScrollWidget TitleLabel,
QWidget#powerScrollWidget SubtitleLabel,
QWidget#powerScrollWidget StrongBodyLabel {
    color: #F5F7FA;
}

QWidget#powerScrollWidget BodyLabel,
QWidget#powerScrollWidget CaptionLabel {
    color: #9AA4B2;
}

QWidget#powerScrollWidget CardWidget,
QWidget#powerScrollWidget SimpleCardWidget,
QWidget#powerSummaryCard,
QWidget#powerReadCard,
QWidget#powerWriteCard,
QWidget#powerLogCard,
QWidget#trendPlotCard,
QWidget[cardRole="metric"] {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
}

QWidget#powerSummaryCard *,
QWidget#powerReadCard *,
QWidget#powerWriteCard *,
QWidget#powerLogCard *,
QWidget[cardRole="metric"] * {
    background: transparent;
}

QWidget#powerSummaryCard BodyLabel,
QWidget#powerReadCard BodyLabel,
QWidget#powerWriteCard BodyLabel,
QWidget#powerLogCard BodyLabel,
QWidget#powerSummaryCard CaptionLabel,
QWidget#powerReadCard CaptionLabel,
QWidget#powerWriteCard CaptionLabel,
QWidget#powerLogCard CaptionLabel,
QWidget[cardRole="metric"] CaptionLabel {
    color: #9AA4B2;
}

QWidget#powerSummaryCard StrongBodyLabel,
QWidget#powerReadCard StrongBodyLabel,
QWidget#powerWriteCard StrongBodyLabel,
QWidget#powerLogCard StrongBodyLabel,
QWidget[cardRole="metric"] TitleLabel,
QWidget[cardRole="metric"] StrongBodyLabel {
    color: #F5F7FA;
}

QWidget#powerScrollWidget LineEdit,
QWidget#powerScrollWidget QLineEdit,
QWidget#powerScrollWidget LineEdit[parameterEditor="true"],
QWidget#powerScrollWidget QLineEdit[parameterEditor="true"] {
    color: #E5ECF3;
    background: rgba(17,24,39,0.88);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 6px 10px;
    selection-background-color: rgba(80,130,255,0.30);
}

QWidget#powerScrollWidget TextEdit,
QWidget#powerScrollWidget QTextEdit,
QWidget#powerScrollWidget QPlainTextEdit {
    color: #E5ECF3;
    background: rgba(9,14,24,0.64);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
}

QWidget#powerScrollWidget ComboBox {
    color: #E5ECF3;
    background: rgba(17,24,39,0.88);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding-left: 8px;
}

QWidget#powerScrollWidget SwitchButton {
    background: transparent;
}

QWidget#powerScrollWidget PillPushButton[accessBadge="true"] {
    color: #D6E4FF;
    border: none;
    border-radius: 14px;
    padding: 0 10px;
    font-weight: 700;
    text-align: center;
}

QWidget#powerScrollWidget PillPushButton[accessBadge="true"][accessType="RO"] {
    background: rgba(249, 115, 22, 0.22);
    color: #FDBA74;
    border: 1px solid rgba(249, 115, 22, 0.34);
}

QWidget#powerScrollWidget PillPushButton[accessBadge="true"][accessType="RW"] {
    background: rgba(59, 130, 246, 0.22);
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.34);
}
