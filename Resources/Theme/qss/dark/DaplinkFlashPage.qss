QScrollArea#DaplinkFlashPage,
QWidget#daplinkScrollWidget {
    background-color: transparent;
    border: none;
}

QScrollArea#DaplinkFlashPage QTextEdit,
QScrollArea#DaplinkFlashPage QLineEdit,
QScrollArea#DaplinkFlashPage LineEdit {
    color: #ffffff;
}

QScrollArea#DaplinkFlashPage QTextEdit {
    background: rgba(255, 255, 255, 0.04);
}

QScrollArea#DaplinkFlashPage QProgressBar {
    min-height: 8px;
    border: none;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
}

QScrollArea#DaplinkFlashPage QProgressBar::chunk {
    border-radius: 4px;
    background: #4CC2FF;
}

