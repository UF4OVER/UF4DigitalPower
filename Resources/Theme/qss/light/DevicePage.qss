QScrollArea#DevicePage,
QWidget#deviceScrollWidget {
    background-color: transparent;
    border: none;
}

/* Log / console (plain/text edit used for device log) */
QScrollArea#DevicePage QPlainTextEdit,
QScrollArea#DevicePage QTextEdit,
QScrollArea#DevicePage PlainTextEdit {
    color: #000000; /* primary text color for light theme */
    background: transparent;
}

/* Read-only logs slightly muted to reduce contrast */
QScrollArea#DevicePage QPlainTextEdit[readOnly="true"],
QScrollArea#DevicePage QTextEdit[readOnly="true"] {
    color: #333333;
}

/* Input line used for TX */
QScrollArea#DevicePage QLineEdit,
QScrollArea#DevicePage LineEdit {
    color: #000000;
    background: rgba(0,0,0,0.03);
}

/* Selection styling (keeps selection readable on light backgrounds) */
QScrollArea#DevicePage QTextEdit::selection,
QScrollArea#DevicePage QPlainTextEdit::selection {
    background: #cfe0ff;
    color: #000000;
}
